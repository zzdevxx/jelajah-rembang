---
/**
 * Motif batik pesisir Lasem otentik dengan detail isen-isen tradisional.
 *
 * Mengangkat 4 ragam hias khas akulturasi pesisir Rembang-Lasem:
 * 1. `kawung`: Kawung Rangkep Lasem — 4 kelopak ganda konsentris, titik isen cecek papat,
 *    dan ceplok intan pusat.
 * 2. `latohan`: Latohan Pesisir — motif endemik Rembang yang menggambarkan rimbun butir
 *    anggur laut (Caulerpa racemosa) dengan sulur meliuk dan riak gelombang ombak banyu.
 * 3. `truntum`: Truntum Kencana — bintang delapan penjuru dengan kuncup melati sari di tengah
 *    dan pendaran embun malam.
 * 4. `sekar-jagad`: Bunga Teratai Lasem — akulturasi Tionghoa-Jawa Lasem dengan kelopak berlapis
 *    anggun dan sulur dedaunan lentur.
 */
interface Props {
  size?: number;
  class?: string;
  /** Aktifkan animasi "Canting Draw". */
  draw?: boolean;
  variant?: 'kawung' | 'truntum' | 'latohan' | 'sekar-jagad';
}
const { size = 120, class: className, draw = false, variant = 'kawung' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 120 120"
  fill="none"
  stroke="currentColor"
  stroke-width="1.35"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={[className, draw && 'canting-draw']}
>
  {
    variant === 'kawung' && (
      <g>
        {/* Lingkaran bingkai luar bermotif cecek halus */}
        <circle cx="60" cy="60" r="50" stroke-opacity="0.3" stroke-dasharray="2.5 3.5" style="--len:314;--delay:0ms" />

        {/* 4 Kelopak luar Kawung Rangkep */}
        <ellipse cx="60" cy="36" rx="16" ry="22" style="--len:122;--delay:80ms" />
        <ellipse cx="60" cy="84" rx="16" ry="22" style="--len:122;--delay:160ms" />
        <ellipse cx="36" cy="60" rx="22" ry="16" style="--len:122;--delay:240ms" />
        <ellipse cx="84" cy="60" rx="22" ry="16" style="--len:122;--delay:320ms" />

        {/* 4 Kelopak dalam konsentris */}
        <ellipse cx="60" cy="36" rx="9" ry="14" stroke-opacity="0.65" style="--len:74;--delay:400ms" />
        <ellipse cx="60" cy="84" rx="9" ry="14" stroke-opacity="0.65" style="--len:74;--delay:460ms" />
        <ellipse cx="36" cy="60" rx="14" ry="9" stroke-opacity="0.65" style="--len:74;--delay:520ms" />
        <ellipse cx="84" cy="60" rx="14" ry="9" stroke-opacity="0.65" style="--len:74;--delay:580ms" />

        {/* Isen-isen cecek papat (titik isian tradisi di dalam kelopak) */}
        <circle cx="60" cy="36" r="1.75" fill="currentColor" stroke="none" />
        <circle cx="60" cy="84" r="1.75" fill="currentColor" stroke="none" />
        <circle cx="36" cy="60" r="1.75" fill="currentColor" stroke="none" />
        <circle cx="84" cy="60" r="1.75" fill="currentColor" stroke="none" />

        {/* Pusat intan ceplok ber-lingkaran ganda */}
        <circle cx="60" cy="60" r="7" style="--len:44;--delay:640ms" />
        <circle cx="60" cy="60" r="3" fill="currentColor" stroke="none" />
        <path d="M60 50 L63 60 L60 70 L57 60 Z" stroke-opacity="0.5" stroke-width="1" />
        <path d="M50 60 L60 63 L70 60 L60 57 Z" stroke-opacity="0.5" stroke-width="1" />

        {/* Ornamen sudut ceplok pojok diagonal */}
        <path d="M30 30 Q38 38 42 30 Q38 22 30 30 Z" stroke-opacity="0.45" stroke-width="1.1" />
        <path d="M90 30 Q82 38 78 30 Q82 22 90 30 Z" stroke-opacity="0.45" stroke-width="1.1" />
        <path d="M30 90 Q38 82 42 90 Q38 98 30 90 Z" stroke-opacity="0.45" stroke-width="1.1" />
        <path d="M90 90 Q82 82 78 90 Q82 98 90 90 Z" stroke-opacity="0.45" stroke-width="1.1" />
      </g>
    )
  }
  {
    variant === 'truntum' && (
      <g>
        {/* Lingkaran konsentris embun malam */}
        <circle cx="60" cy="60" r="48" stroke-opacity="0.25" stroke-dasharray="2 3" style="--len:301;--delay:0ms" />
        <circle cx="60" cy="60" r="28" stroke-opacity="0.35" style="--len:176;--delay:80ms" />

        {/* 8 Arah Sinar Bintang Truntum Kencana */}
        <path d="M60 14 L60 38 M60 82 L60 106 M14 60 L38 60 M82 60 L106 60" style="--len:24;--delay:160ms" />
        <path d="M27 27 L44 44 M76 76 L93 93 M93 27 L76 44 M44 76 L27 93" style="--len:24;--delay:240ms" />

        {/* Mahkota kelopak intan melati mekar */}
        <path
          d="M60 38 C72 38 78 44 82 60 C78 76 72 82 60 82 C48 82 42 76 38 60 C42 44 48 38 60 38 Z"
          style="--len:158;--delay:320ms"
        />
        <path
          d="M60 44 C69 44 73 48 76 60 C73 72 69 76 60 76 C51 76 47 72 44 60 C47 48 51 44 60 44 Z"
          stroke-opacity="0.6"
          style="--len:120;--delay:400ms"
        />

        {/* Kuncup sari melati pusat */}
        <circle cx="60" cy="60" r="5" style="--len:31;--delay:480ms" />
        <circle cx="60" cy="60" r="2.2" fill="currentColor" stroke="none" />

        {/* Isen-isen cecek bintang (pendaran kilau embun) */}
        <circle cx="60" cy="14" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="60" cy="106" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="14" cy="60" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="106" cy="60" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="27" cy="27" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="93" cy="27" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="27" cy="93" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="93" cy="93" r="1.5" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    variant === 'latohan' && (
      <g>
        {/* Riak gelombang ombak banyu pesisir di dasar */}
        <path
          d="M16 102 C30 96 42 108 58 102 C74 96 86 108 104 102"
          stroke-opacity="0.35"
          style="--len:90;--delay:0ms"
        />
        <path
          d="M24 108 C36 103 48 112 62 108 C76 103 88 112 98 108"
          stroke-opacity="0.2"
          style="--len:76;--delay:60ms"
        />

        {/* Sulur utama tanaman anggur laut Caulerpa racemosa */}
        <path
          d="M60 98 C60 76 46 62 48 42 C50 26 62 16 68 14"
          stroke-width="1.6"
          style="--len:92;--delay:120ms"
        />
        {/* Cabang sulur kedua */}
        <path
          d="M56 66 C70 58 76 46 72 32 C70 24 64 20 62 18"
          stroke-opacity="0.8"
          style="--len:62;--delay:180ms"
        />
        {/* Cabang sulur ketiga */}
        <path
          d="M49 46 C36 42 30 32 34 22 C37 16 44 16 48 18"
          stroke-opacity="0.7"
          style="--len:48;--delay:240ms"
        />

        {/* Rimbun butir anggur laut (isen butiran latoh khas pesisir) */}
        <circle cx="68" cy="14" r="3.5" style="--len:22;--delay:300ms" />
        <circle cx="68" cy="14" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="76" cy="22" r="3.8" style="--len:24;--delay:340ms" />
        <circle cx="80" cy="32" r="4.2" style="--len:26;--delay:380ms" />
        <circle cx="80" cy="32" r="1.8" fill="currentColor" stroke="none" />
        <circle cx="75" cy="42" r="3.8" style="--len:24;--delay:420ms" />
        <circle cx="66" cy="50" r="3.5" style="--len:22;--delay:460ms" />

        <circle cx="34" cy="22" r="3.5" style="--len:22;--delay:320ms" />
        <circle cx="34" cy="22" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="28" cy="32" r="3.8" style="--len:24;--delay:360ms" />
        <circle cx="32" cy="42" r="3.5" style="--len:22;--delay:400ms" />
        <circle cx="42" cy="36" r="3" style="--len:19;--delay:440ms" />

        <circle cx="58" cy="32" r="4" style="--len:25;--delay:480ms" />
        <circle cx="58" cy="32" r="1.6" fill="currentColor" stroke="none" />
        <circle cx="48" cy="56" r="3.5" style="--len:22;--delay:520ms" />
        <circle cx="64" cy="62" r="3.2" style="--len:20;--delay:560ms" />
        <circle cx="52" cy="74" r="3" style="--len:19;--delay:600ms" />

        {/* Tetesan air pesisir sekeliling */}
        <circle cx="44" cy="14" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="86" cy="20" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="22" cy="42" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="88" cy="46" r="1.2" fill="currentColor" stroke="none" />
      </g>
    )
  }
  {
    variant === 'sekar-jagad' && (
      <g>
        {/* Lingkaran pembingkai mandala teratai */}
        <circle cx="60" cy="60" r="50" stroke-opacity="0.25" stroke-dasharray="3 3" style="--len:314;--delay:0ms" />

        {/* Kelopak teratai bunga mekar (akulturasi Tionghoa-Jawa Lasem) */}
        <path
          d="M60 22 C68 34 76 46 76 60 C76 74 68 86 60 98 C52 86 44 74 44 60 C44 46 52 34 60 22 Z"
          style="--len:160;--delay:100ms"
        />
        <path
          d="M22 60 C34 52 46 44 60 44 C74 44 86 52 98 60 C86 68 74 76 60 76 C46 76 34 68 22 60 Z"
          style="--len:160;--delay:200ms"
        />

        {/* Kelopak diagonal mekar sekunder */}
        <path
          d="M33 33 C46 42 54 50 60 60 C50 54 42 46 33 33 Z"
          stroke-opacity="0.6"
          style="--len:60;--delay:300ms"
        />
        <path
          d="M87 33 C74 42 66 50 60 60 C70 54 78 46 87 33 Z"
          stroke-opacity="0.6"
          style="--len:60;--delay:360ms"
        />
        <path
          d="M33 87 C46 78 54 70 60 60 C50 66 42 74 33 87 Z"
          stroke-opacity="0.6"
          style="--len:60;--delay:420ms"
        />
        <path
          d="M87 87 C74 78 66 70 60 60 C70 66 78 74 87 87 Z"
          stroke-opacity="0.6"
          style="--len:60;--delay:480ms"
        />

        {/* Mahkota sari bunga pusat */}
        <circle cx="60" cy="60" r="8" style="--len:50;--delay:540ms" />
        <circle cx="60" cy="60" r="4" fill="currentColor" stroke="none" />

        {/* Isen cecek putik sari */}
        <circle cx="60" cy="32" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="60" cy="88" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="32" cy="60" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="88" cy="60" r="1.5" fill="currentColor" stroke="none" />
      </g>
    )
  }
</svg>
